---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap nf">
    <p class="mono faint">Error 404</p>
    <h1>This page isn’t <span class="serif">built yet.</span></h1>
    <p class="muted">Like a lot of things here, it may exist in a future version. For now, try the homepage.</p>
    <a href="/" class="btn btn--solid">Back home</a>
  </section>
</Base>

<style>
  .nf {
    padding-top: clamp(64px, 14vw, 180px);
    min-height: 60svh;
  }
  h1 {
    font-size: clamp(2.8rem, 9vw, 7rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
    margin: 12px 0 24px;
    max-width: 14ch;
  }
  .serif {
    font-weight: 400;
  }
  p.muted {
    max-width: 44ch;
    font-size: 1.1rem;
    margin-bottom: 28px;
  }
</style>
